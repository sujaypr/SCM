# Core Application
GEMINI_API_KEY=
SECRET_KEY=dev-secret-change-me
ENV=development

# Database (override in production)
DATABASE_URL=sqlite:///./ai_supplychain.db

# Logistics / External APIs
NEWS_API_KEY=
OPENWEATHER_API_KEY=
ORS_API_KEY=

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:3000

# Feature Flags
ENABLE_LOGISTICS=true
ENABLE_SCENARIO_ANALYSIS=true
ENABLE_REPORT_EXPORT=true

# Model / AI Settings
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=30

# Optional Redis (future)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info
